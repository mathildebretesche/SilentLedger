# Silent Ledger – Environment Variables
# Copier ce fichier en .env.local et remplir les valeurs

# ── Reclaim Protocol ───────────────────────────────────────────────────────────
# Créer une app sur https://dev.reclaimprotocol.org/
NEXT_PUBLIC_RECLAIM_APP_ID=your_reclaim_app_id
NEXT_PUBLIC_RECLAIM_APP_SECRET=your_reclaim_app_secret
NEXT_PUBLIC_RECLAIM_GITHUB_PROVIDER_ID=your_github_provider_id

# ── Smart Contract ─────────────────────────────────────────────────────────────
# Adresse de SilentLedgerAttester après `forge script` + déploiement
NEXT_PUBLIC_ATTESTER_ADDRESS=0x0000000000000000000000000000000000000000

# ── WalletConnect ──────────────────────────────────────────────────────────────
# Créer un project sur https://cloud.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ── App URL ────────────────────────────────────────────────────────────────────
# URL publique de l'app (utilisée pour le callback Reclaim)
NEXT_PUBLIC_APP_URL=http://localhost:3000
